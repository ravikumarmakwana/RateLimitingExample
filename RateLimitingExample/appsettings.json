{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Fixed": {
      "PermitLimit": 5,
      "WindowSeconds": 10
    },
    "Sliding": {
      "PermitLimit": 5,
      "WindowSeconds": 10,
      "Segments": 2
    },
    "Token": {
      "TokenLimit": 5,
      "TokenPerPeriod": 2,
      "ReplenishmentSeconds": 5
    },
    "Concurrency": {
      "PermitLimit": 2
    }
  }
}
